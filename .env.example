# JJCET-STIF — never commit real secrets
# Database (default is local JSON file; set these only if using Firestore/SMTP)
# DATABASE_URL=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Outgoing mail (optional — if unset, submissions are logged + stored and admin is notified on dashboard)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="JJCET-STIF <no-reply@jjcet.ac.in>"
# ADMIN_NOTIFY_EMAIL=stif@jjcet.ac.in
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard auth (CHANGE in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me-in-production
ADMIN_SECRET=please-set-a-long-random-string-min-32-chars
# Set to "true" when serving the site over HTTPS so the admin session cookie is Secure
# ADMIN_COOKIE_SECURE=true
